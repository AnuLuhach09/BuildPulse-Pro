generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  ADMIN
  DEVELOPER
  VIEWER
}

enum RepoRole {
  OWNER
  MAINTAINER
  DEVELOPER
  VIEWER
}

enum RunStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  WAITING
}

enum Conclusion {
  SUCCESS
  FAILURE
  CANCELLED
  SKIPPED
  TIMED_OUT
  NEUTRAL
  ACTION_REQUIRED
}

enum DeploymentStatus {
  PENDING
  ACTIVE
  FAILED
  INACTIVE
  DESTROYED
}

// =============================================================================
// USER & AUTHENTICATION
// =============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  githubId     String?  @unique
  githubLogin  String?
  role         Role     @default(DEVELOPER)
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  repositories   RepositoryMember[]
  pipelineRuns   PipelineRun[]
  auditLogs      AuditLog[]
  notifications  NotificationPref?
  apiKeys        ApiKey[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// =============================================================================
// REPOSITORIES
// =============================================================================

model Repository {
  id            String   @id @default(cuid())
  githubId      Int      @unique
  name          String
  fullName      String   @unique
  description   String?
  url           String
  defaultBranch String   @default("main")
  isPrivate     Boolean  @default(false)
  webhookId     Int?
  webhookSecret String
  healthScore   Float    @default(0)
  language      String?
  topics        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members     RepositoryMember[]
  pipelines   Pipeline[]
  deployments Deployment[]
  auditLogs   AuditLog[]

  @@map("repositories")
}

model RepositoryMember {
  userId       String
  repositoryId String
  role         RepoRole @default(VIEWER)
  joinedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([userId, repositoryId])
  @@map("repository_members")
}

// =============================================================================
// PIPELINES & RUNS
// =============================================================================

model Pipeline {
  id               String @id @default(cuid())
  githubWorkflowId Int
  name             String
  path             String
  repositoryId     String
  state            String @default("active")

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       PipelineRun[]

  @@unique([githubWorkflowId, repositoryId])
  @@map("pipelines")
}

model PipelineRun {
  id            String      @id @default(cuid())
  githubRunId   BigInt      @unique
  pipelineId    String
  triggeredById String?
  branch        String
  commitSha     String
  commitMessage String?
  eventType     String      @default("push")  // push, pull_request, workflow_dispatch
  status        RunStatus
  conclusion    Conclusion?
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  htmlUrl       String
  attemptNumber Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pipeline    Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  triggeredBy User?        @relation(fields: [triggeredById], references: [id])
  jobs        BuildJob[]
  logs        BuildLog[]
  aiAnalysis  AIAnalysis?

  @@index([pipelineId])
  @@index([branch])
  @@index([status])
  @@index([createdAt])
  @@map("pipeline_runs")
}

model BuildJob {
  id            String      @id @default(cuid())
  githubJobId   BigInt      @unique
  pipelineRunId String
  name          String
  runnerId      Int?
  runnerName    String?
  status        RunStatus
  conclusion    Conclusion?
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?

  run   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  steps BuildStep[]

  @@index([pipelineRunId])
  @@map("build_jobs")
}

model BuildStep {
  id          String      @id @default(cuid())
  jobId       String
  name        String
  number      Int
  status      RunStatus
  conclusion  Conclusion?
  startedAt   DateTime?
  completedAt DateTime?

  job BuildJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("build_steps")
}

model BuildLog {
  id            String   @id @default(cuid())
  pipelineRunId String
  jobId         String?
  content       String   @db.Text
  lineNumber    Int?
  createdAt     DateTime @default(now())

  run PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId])
  @@map("build_logs")
}

// =============================================================================
// AI ANALYSIS
// =============================================================================

model AIAnalysis {
  id            String   @id @default(cuid())
  pipelineRunId String   @unique
  failureReason String   @db.Text
  suggestedFix  String   @db.Text
  affectedFiles String[] @default([])
  confidence    Float    @default(0)
  model         String   @default("gpt-4o-mini")
  promptTokens  Int?
  createdAt     DateTime @default(now())

  run PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

// =============================================================================
// DEPLOYMENTS
// =============================================================================

model Deployment {
  id           String           @id @default(cuid())
  repositoryId String
  environment  String           // production, staging, preview
  status       DeploymentStatus
  version      String
  commitSha    String
  commitMessage String?
  deployedBy   String?
  deployedAt   DateTime         @default(now())
  completedAt  DateTime?
  rollbackOf   String?          // ID of deployment this rolls back
  metadata     Json?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([environment])
  @@index([deployedAt])
  @@map("deployments")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model NotificationPref {
  id           String  @id @default(cuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  slackEnabled Boolean @default(false)
  slackWebhook String?
  onFailure    Boolean @default(true)
  onSuccess    Boolean @default(false)
  onDeploy     Boolean @default(true)
  onRecovery   Boolean @default(true) // When a previously failing run succeeds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  repositoryId String?
  action       String   // HTTP method or custom action name
  entity       String   // Resource type (users, repos, pipelines...)
  entityId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// API KEYS
// =============================================================================

model ApiKey {
  id        String    @id @default(cuid())
  name      String
  keyHash   String    @unique
  prefix    String    // e.g. "bp_"
  userId    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}
