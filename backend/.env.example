# =============================================================================
# BuildPulse Pro – Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL / Neon) ──────────────────────────────────────────────
DATABASE_URL="postgresql://buildpulse:password@localhost:5432/buildpulse_dev?schema=public"

# ── Redis (Upstash or local) ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For Upstash TLS: redis://:<password>@<host>:<port>

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# ── GitHub API ────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET="your-webhook-hmac-secret-at-least-32-chars"
GITHUB_APP_TOKEN=""

# ── AI Provider (Groq) ───────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="BuildPulse Pro <noreply@buildpulse.io>"

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_DEFAULT_WEBHOOK_URL=""

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
